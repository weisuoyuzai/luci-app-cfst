
config cfst 'global'
	option enabled '0'
	option backend 'auto'
	option match_mode 'keyword'
	option node_keyword 'cf优选'
	option node_backend ''
	option bypass_local_proxy '1'
	option auto_download '1'
	option cron_enabled '0'
	option cron_time '30 3 * * *'
	option cfst_threads '200'
	option cfst_ping_count '4'
	option cfst_download_count '10'
	option cfst_download_time '10'
	option cfst_latency_limit '200'
	option cfst_loss_limit '0.2'
	option cfst_speed_limit '5'
	option cfst_result_count '5'
	option cfst_colo ''
	option ip_txt ''
	option mirror_prefix 'https://gh-proxy.com/'
	option cfst_bin_url ''
