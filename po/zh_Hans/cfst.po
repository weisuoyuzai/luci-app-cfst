msgstr "OpenClash（尽力而为）"

msgid "not detected"
msgstr "未检测到"

msgid "Node match mode"
msgstr "节点匹配方式"

msgid "Match by selecting node(s)"
msgstr "手动选择节点"

msgid "Match by remark keyword"
msgstr "按备注关键字匹配"

msgid "Node(s)"
msgstr "节点"

msgid "Loaded from backend: %s. If you change the Backend above, click Save, then reopen this page to refresh this list."
msgstr "节点列表来自：%s。如果修改了上方的代理类型，请先保存，再重新打开本页面以刷新列表。"

msgid "Could not load the node list (%s). Save your backend selection and reopen this page, or use the keyword match mode instead."
msgstr "无法加载节点列表（%s）。请保存代理类型选择后重新打开本页面，或改用关键字匹配方式。"

msgid "No nodes available"
msgstr "暂无可用节点"

msgid "unknown error"
msgstr "未知错误"

msgid "Remark keyword"
msgstr "备注关键字"

msgid "Any node whose remark contains this text will be updated."
msgstr "备注中包含该文本的节点都会被更新。"

msgid "Bypass local proxy while testing"
msgstr "测速时临时关闭本机代理"

msgid "Temporarily disables the \"localhost proxy\" setting during the speed test so the test itself is not routed through the proxy. Only supported for PassWall / PassWall2; has no effect for OpenClash."
msgstr "测速期间临时关闭“本机代理”设置，避免测速流量被代理本身转发。仅 PassWall / PassWall2 支持，对 OpenClash 无效。"

msgid "Schedule"
msgstr "定时任务"

msgid "Enable scheduled run"
msgstr "启用定时运行"

msgid "Cron schedule"
msgstr "Cron 时间表达式"

msgid "Standard 5-field cron expression (minute hour day month weekday)."
msgstr "标准 5 段式 cron 表达式（分 时 日 月 星期）。"

msgid "Cron schedule is required when scheduled run is enabled"
msgstr "启用定时运行时必须填写 cron 时间表达式"

msgid "Must be a 5-field cron expression, e.g. \"30 3 * * *\""
msgstr "必须是 5 段式 cron 表达式，例如 “30 3 * * *”"

msgid "Invalid characters in field %d"
msgstr "第 %d 段包含非法字符"

msgid "cfst Binary"
msgstr "cfst 程序"

msgid "Detected architecture"
msgstr "检测到的架构"

msgid "unknown (unsupported architecture)"
msgstr "未知（不支持的架构）"

msgid "Binary status"
msgstr "程序状态"

msgid "Installed"
msgstr "已安装"

msgid "Not installed"
msgstr "未安装"

msgid "Auto-download if missing"
msgstr "缺失时自动下载"

msgid "Automatically download cfst on first run if the binary is not present yet."
msgstr "首次运行时若程序不存在则自动下载 cfst。"

msgid "GitHub mirror prefix"
msgstr "GitHub 加速前缀"

msgid "Prepended to the GitHub release download URL to speed up access. Leave empty to download directly from GitHub. This field may need to be updated over time as public mirrors change."
msgstr "拼接在 GitHub Release 下载地址前，用于加速访问。留空则直接从 GitHub 下载。公共加速地址可能会失效，需要时手动更新此项。"

msgid "Custom download URL (advanced)"
msgstr "自定义下载地址（高级）"

msgid "If set, this exact URL is downloaded as-is, bypassing architecture detection and the mirror prefix."
msgstr "填写后将直接下载此地址，跳过架构检测和加速前缀。"

msgid "Update cfst binary now"
msgstr "立即更新 cfst 程序"

msgid "Update Now"
msgstr "立即更新"

msgid "An update is already in progress"
msgstr "已有更新任务正在进行"

msgid "Downloading cfst in the background..."
msgstr "正在后台下载 cfst……"

msgid "Downloading..."
msgstr "下载中..."

msgid "Update failed: %s"
msgstr "更新失败：%s"

msgid "Speed Test Parameters"
msgstr "测速参数"

msgid "Latency test threads (-n)"
msgstr "延迟测试线程数 (-n)"

msgid "Latency test count (-t)"
msgstr "延迟测试次数 (-t)"

msgid "Download test count (-dn)"
msgstr "下载测速数量 (-dn)"

msgid "Number of IPs to run the download speed test on. Default: 10."
msgstr "参与下载测速的 IP 数量，默认 10。"

msgid "Download test duration seconds (-dt)"
msgstr "下载测速时长（秒） (-dt)"

msgid "Max average latency ms (-tl)"
msgstr "平均延迟上限（毫秒） (-tl)"

msgid "Max packet loss rate (-tlr)"
msgstr "丢包率上限 (-tlr)"

msgid "Must be a number between 0 and 1"
msgstr "必须是 0 到 1 之间的数值"

msgid "Min download speed MB/s (-sl)"
msgstr "下载速度下限 MB/s (-sl)"

msgid "Result count to keep (-p)"
msgstr "保留结果数量 (-p)"

msgid "Custom IP range file (advanced)"
msgstr "自定义 IP 段文件（高级）"

msgid "Test only these regions (-cfcolo)"
msgstr "仅测试所选区域 (-cfcolo)"

msgid "Leave everything unchecked and empty to test all Cloudflare colos."
msgstr "全部不勾选且留空表示测试所有 Cloudflare 节点城市。"

msgid "Additional/custom IATA codes, comma-separated"
msgstr "附加/自定义 IATA 代码，用英文逗号分隔"

msgid "Speed test Cloudflare IPs and automatically apply the best IP to the selected PassWall / PassWall2 / OpenClash node(s)."
msgstr "测速 Cloudflare IP 并自动将最优 IP 应用到所选的 PassWall / PassWall2 / OpenClash 节点。"

msgid "A run is already in progress"
msgstr "已有测速任务正在运行"

msgid "Speed test started in the background. Check the Log / Speedtest Results tabs for progress."
msgstr "测速任务已在后台启动，可在“日志”/“测速结果”标签页查看进度。"

msgid "If more than one backend is installed, \"Auto detect\" will refuse to run and you must pick one explicitly here."
msgstr "如果同时安装了多个代理插件，“自动识别”将拒绝运行，需要在此手动指定一个。"

msgid "Running..."
msgstr "运行中……"

msgid "Idle - last run: %s, result: %s%s"
msgstr "空闲 - 上次运行：%s，结果：%s%s"

msgid "Idle - no run yet"
msgstr "空闲 - 尚未运行过"

msgid "Refresh"
msgstr "刷新"

msgid "Clear Log"
msgstr "清空日志"

msgid "No results yet. Run a speed test from the Basic Settings tab."
msgstr "暂无结果，请在基础设置页点击立即运行进行测速。"

